
# ==========================================
# TaskPilot AI - Environment Configuration
# ==========================================

# AI provider mode:
# local  = Use the LLM running on your computer
# cloud  = Use a hosted LLM through an API
# auto   = Try the cloud API first, then fall back to local
AI_PROVIDER=local


# ==========================================
# LOCAL LLM CONFIGURATION (Ollama)
# ==========================================

# Local Ollama server address
OLLAMA_BASE_URL=http://localhost:11434

# Model already installed on this computer
OLLAMA_MODEL=qwen2.5:3b


# ==========================================
# CLOUD LLM API CONFIGURATION
# ==========================================

# Name of the cloud API provider (for example, openai or gemini)
CLOUD_API_PROVIDER=

# API endpoint supplied by your cloud provider
CLOUD_API_BASE_URL=

# Secret API key from your cloud provider
CLOUD_API_KEY=

# Model name supported by your selected cloud provider
CLOUD_API_MODEL=

# Request timeout in seconds
CLOUD_API_TIMEOUT=30


# ==========================================
# TASKPILOT APPLICATION CONFIGURATION
# ==========================================

# SQLite database path for persistent task storage
TASKPILOT_DB=taskpilot.db

# Maximum number of tool-calling rounds per assistant request
MAX_AGENT_STEPS=6

# Enable application debug logging
DEBUG=false
